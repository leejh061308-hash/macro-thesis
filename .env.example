# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
# 뉴스 AI 요약 및 종목 AI 분석에 사용됩니다.
OPENAI_API_KEY=sk-your-api-key-here

# 메인 뉴스 관리자 키 (8자 이상, 직접 설정)
# 뉴스 탭에서 메인 뉴스 업로드 시 사용
ADMIN_SECRET=your-admin-secret-here

# PostgreSQL (메인 뉴스·관심종목 영구 저장)
# Railway: Postgres 플러그인 추가 시 DATABASE_URL 자동 설정
DATABASE_URL=postgresql://user:password@localhost:5432/macrolens

# Finnhub API 키 (Railway 등 서버 환경에서 Yahoo 시세 대체용, 무료)
# https://finnhub.io/register 에서 발급
FINNHUB_API_KEY=your-finnhub-api-key-here

# SQLite 저장 경로 (RSS AI 요약 캐시용, 선택)
# DATA_DIR=/app/data
