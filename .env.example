# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
# 뉴스 AI 요약 및 종목 AI 분석에 사용됩니다.
OPENAI_API_KEY=sk-your-api-key-here

# 메인 뉴스 관리자 키 (8자 이상, 직접 설정)
# 뉴스 탭에서 메인 뉴스 업로드 시 사용
ADMIN_SECRET=your-admin-secret-here

# SQLite 저장 경로 (Railway Volume 마운트 경로와 동일하게 설정)
# Railway: Volume 추가 후 Mount Path를 /app/data 로 설정하거나,
# Railway가 주입하는 RAILWAY_VOLUME_MOUNT_PATH 를 자동 사용합니다.
# DATA_DIR=/app/data
